{
  "version": 1,
  "hooks": {
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\.github\\hooks\\scripts\\log-prompt.ps1",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\.github\\hooks\\scripts\\log-response.ps1",
        "cwd": ".",
        "timeoutSec": 10
      }
    ]
  }
}
