{
  "description": "Minimal Codex session capture: submitted prompts and final responses only.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\.codex\\hooks\\capture-codex.ps1",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\.codex\\hooks\\capture-codex.ps1",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
